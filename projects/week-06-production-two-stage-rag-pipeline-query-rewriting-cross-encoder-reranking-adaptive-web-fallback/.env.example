# Copy to .env only if you want to customize settings. Never commit real keys.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
TAVILY_API_KEY=
EMBEDDING_MODEL=all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Default is .chroma inside the project; Docker Compose uses /data/chroma.
CHROMA_DIR=.chroma